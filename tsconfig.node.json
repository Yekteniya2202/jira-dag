{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist/node",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/electron", "src/server", "src/shared", "src/web"]
}
