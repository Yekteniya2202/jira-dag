{
  "name": "jira-dag",
  "version": "0.2.0",
  "private": true,
  "description": "Visual editor for Jira issue dependencies",
  "license": "MIT",
  "author": {
    "name": "Mikhail Babaev",
    "url": "https://github.com/Yekteniya2202"
  },
  "homepage": "https://github.com/Yekteniya2202/jira-dag",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yekteniya2202/jira-dag.git"
  },
  "type": "module",
  "main": "dist/node/electron/main.js",
  "desktopName": "jira-dag.desktop",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build:node && concurrently --kill-others --success first \"vite\" \"wait-on http-get://127.0.0.1:5173 && electron . --dev\"",
    "dev:web": "npm run build:node && concurrently --kill-others --success first \"vite\" \"node --watch dist/node/web/main.js\" \"tsc --project tsconfig.node.json --watch --preserveWatchOutput\"",
    "build:renderer": "vite build",
    "build:node": "tsc --project tsconfig.node.json",
    "build": "npm run typecheck && npm run build:renderer && npm run build:node",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.node.json --noEmit",
    "test": "npm run build:node && node --test \"dist/node/**/*.test.js\"",
    "smoke:desktop": "electron . --smoke-test",
    "start": "electron .",
    "start:web": "node dist/node/web/main.js",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@xyflow/react": "12.12.1",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "wait-on": "9.5.1"
  }
}
